# 复制为 .env 后填写：cp .env.example .env
#
# .env 只给 Docker Compose / NapCat 使用；qqbot 自己的配置统一写在 .qqbotrc.toml。

# 必填：Bot 自己的 QQ 号
BOT_QQ=

# 可选：NapCat 启动模式。默认 ws 会启用 OneBot v11 WebSocket。
NAPCAT_MODE=ws

# 可选：Docker 中 qqbot 连接的 OneBot 地址。默认连接 compose 内置 napcat 服务。
# 如果使用外部 OneBot/NapCat 服务，再取消注释并修改。
# ONEBOT_WS_URL=ws://napcat:3001
